generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  username     String        @unique @default(uuid())
  password     String
  role         Role          @default(RESELLER)
  uidLimit     Int           @default(0) @map("uid_limit")
  freeUidLimit Int           @default(50) @map("free_uid_limit")
  apiKey       String        @unique @default(uuid()) @map("api_key")
  profilePicture String?     @map("profile_picture")
  createdBy    String?       @map("created_by") @db.ObjectId
  creator      User?         @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdUsers User[]        @relation("CreatedBy")
  uids         Uid[]
  logs         ActivityLog[]
  portals      FreePortal[]
  messages     ChatMessage[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

enum Role {
  RESELLER
  MANAGER
  ADMIN
}

model Uid {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @map("user_id") @db.ObjectId
  user      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  uidValue  String    @map("uid_value")
  duration  Int
  status    UidStatus @default(ACTIVE)
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@index([uidValue])
  @@index([userId])
  @@map("uids")
}

enum UidStatus {
  ACTIVE
  EXPIRED
  DELETED
}

model ActivityLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String   @map("user_id") @db.ObjectId
  user        User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action      String
  description String
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("activity_logs")
}

model SystemSetting {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  settingKey   String   @unique @map("setting_key")
  settingValue String
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FreePortal {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  userId        String    @map("user_id") @db.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  brandName     String    @map("brand_name")
  durationHours Int       @map("duration_hours")
  maxUids       Int       @map("max_uids")
  usedUids      Int       @default(0) @map("used_uids")
  token         String    @unique @default(uuid())
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("free_portals")
}

model SystemAlert {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  type      String
  message   String
  active    Boolean   @default(true)
  startsAt  DateTime  @default(now()) @map("starts_at")
  endsAt    DateTime? @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("system_alerts")
}

model ChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @map("user_id") @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}
